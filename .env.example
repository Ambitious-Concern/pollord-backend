# Database
POSTGRES_USER=pollord
POSTGRES_PASSWORD=change-me
POSTGRES_DB=pollord
DATABASE_URL=postgresql+asyncpg://pollord:change-me@db:5432/pollord

# Redis
REDIS_URL=redis://redis:6379/0

# JWT
SECRET_KEY=change-me-in-production-use-a-long-random-string
JWT_SECRET_KEY=change-me-jwt-secret-use-a-long-random-string
JWT_ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=1440
REFRESH_TOKEN_EXPIRE_DAYS=7

# Password Hashing
BCRYPT_ROUNDS=12

# Vote Encryption
AES_ENCRYPTION_KEY=change-me-must-be-32-bytes-hex-encoded-key
HMAC_SECRET_KEY=change-me-hmac-secret-for-voter-anonymization

# Email (Zoho SMTP)
MAIL_HOST=smtp.zoho.com
MAIL_PORT=465
MAIL_USERNAME=noreply@example.com
MAIL_PASSWORD=change-me
MAIL_FROM=noreply@example.com
MAIL_FROM_NAME=Pollord
MAIL_USE_SSL=true
MAIL_USE_TLS=false

# OTP
OTP_EXPIRE_MINUTES=10

# CORS
CORS_ORIGINS=["https://yourdomain.com"]

# Rate Limiting
RATE_LIMIT_DEFAULT=100/minute
RATE_LIMIT_VOTING=10/minute
RATE_LIMIT_AUTH=5/minute

# App
APP_NAME=Pollard API
APP_VERSION=1.0.0
DEBUG=false
FRONTEND_URL=https://yourdomain.com

# Paystack
PAYSTACK_SECRET_KEY=change-me
PAYSTACK_PUBLIC_KEY=change-me
VOTE_PRICE=100
VOTE_CURRENCY=GHS

# Whatsapp
WHATSAPP_ACCESS_TOKEN=change-me
WHATSAPP_PHONE_NUMBER_ID=change-me
WHATSAPP_VERIFY_TOKEN=change-me
WHATSAPP_APP_SECRET=change-me
WHATSAPP_API_VERSION=v19.0

# Docker image (used by docker-compose.prod.yml)
REGISTRY=ghcr.io
IMAGE_NAME=ambitious-concern/pollard-backend
IMAGE_TAG=latest
