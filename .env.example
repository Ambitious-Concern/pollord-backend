# Database
DATABASE_URL=postgresql+asyncpg://pollard:pollard@db:5432/pollard

# Redis
REDIS_URL=redis://redis:6379/0

# JWT
SECRET_KEY=change-me-in-production-use-a-long-random-string
JWT_SECRET_KEY=change-me-jwt-secret-use-a-long-random-string
JWT_ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=1440
REFRESH_TOKEN_EXPIRE_DAYS=7

# Password Hashing
BCRYPT_ROUNDS=12

# Vote Encryption
AES_ENCRYPTION_KEY=change-me-must-be-32-bytes-hex-encoded-key
HMAC_SECRET_KEY=change-me-hmac-secret-for-voter-anonymization

# Email
MAIL_USERNAME=
MAIL_PASSWORD=
MAIL_FROM=noreply@pollard.com
MAIL_SERVER=smtp.gmail.com
MAIL_PORT=587
MAIL_FROM_NAME=Pollard Platform

# CORS
CORS_ORIGINS=["http://localhost:3000","http://localhost:8080"]

# Rate Limiting
RATE_LIMIT_DEFAULT=100/minute
RATE_LIMIT_VOTING=10/minute
RATE_LIMIT_AUTH=5/minute

# App
APP_NAME=Pollard API
APP_VERSION=1.0.0
DEBUG=true
